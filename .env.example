# =============================================================================
# SlideText Studio - Konfigurace prostředí
# =============================================================================

# Vše funguje 100% ZDARMA bez jakéhokoliv API klíče a bez platební karty!

# 1. Lokální AI: Gemma 4 přes Ollama (zcela zdarma a offline)
# Spusťte v terminálu: ollama run gemma4:latest
OLLAMA_HOST="http://127.0.0.1:11434"
GEMMA_MODEL="gemma4:latest"

# 2. Volitelné: Vlastní placený API klíč (pouze pokud jej chcete použít místo bezplatného Google Překladače)
# GOOGLE_TRANSLATE_API_KEY="váš_volitelný_klíč"
# DEEPL_API_KEY="váš_volitelný_klíč"

# 3. Port serveru (výchozí 3000)
PORT=3000
